#!/usr/bin/env python3
"""lightcv map server: serves the world, the map view, and the editor.

Deliberately stdlib-only (http.server). This fork has no packaging
discipline and no dependency budget to spend; the whole point is that it
can be thrown away.

Endpoints
    GET  /                  the map view + editor
    GET  /api/world         the world as JSON
    GET  /api/map.png       rendered top-down map (rendered ON CHANGE)
    GET  /api/revision      {revision} -- cheap poll target
    POST /api/world         replace sectors (the editor's save)
    POST /api/observe       {x, y, kind, confidence} -- a manual write
    GET  /api/backdrop.png  camera median, for tracing the floor over
"""

import io
import json
import os
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlparse

import cv2
import numpy as np

_ROOT = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, _ROOT)

from lightcv.world import World, Sector          # noqa: E402
from lightcv.render import MapRenderer, RenderCache  # noqa: E402

MAP_PATH = os.environ.get('LIGHTCV_MAP',
                          os.path.expanduser('~/.local/share/lightcv/world.json'))
BACKDROP = os.environ.get('LIGHTCV_BACKDROP',
                          os.path.join(_ROOT, 'doc', 'median.png'))
PORT = int(os.environ.get('LIGHTCV_PORT', '5100'))

_lock = threading.Lock()
_world = World.load(MAP_PATH)
_world.path = MAP_PATH
_cache = RenderCache(MapRenderer(1000, 700))


def _png(img):
    ok, buf = cv2.imencode('.png', img)
    return buf.tobytes() if ok else b''


class H(BaseHTTPRequestHandler):
    def log_message(self, *a):
        pass

    def _send(self, code, body, ctype='application/json'):
        if isinstance(body, str):
            body = body.encode()
        self.send_response(code)
        self.send_header('Content-Type', ctype)
        self.send_header('Content-Length', str(len(body)))
        self.send_header('Cache-Control', 'no-store')
        self.end_headers()
        self.wfile.write(body)

    def do_GET(self):
        p = urlparse(self.path).path
        if p in ('/', '/index.html'):
            with open(os.path.join(_ROOT, 'web', 'map.html'), 'rb') as f:
                return self._send(200, f.read(), 'text/html; charset=utf-8')
        if p == '/api/world':
            with _lock:
                return self._send(200, json.dumps(_world.to_dict()))
        if p == '/api/revision':
            with _lock:
                return self._send(200, json.dumps({'revision': _world.revision}))
        if p == '/api/map.png':
            with _lock:
                img = _cache.frame_for(_world)
            return self._send(200, _png(cv2.cvtColor(img, cv2.COLOR_RGB2BGR)),
                              'image/png')
        if p == '/api/backdrop.png':
            if os.path.exists(BACKDROP):
                with open(BACKDROP, 'rb') as f:
                    return self._send(200, f.read(), 'image/png')
            return self._send(404, json.dumps({'error': 'no backdrop'}))
        return self._send(404, json.dumps({'error': 'not found'}))

    def do_POST(self):
        p = urlparse(self.path).path
        n = int(self.headers.get('Content-Length', 0) or 0)
        try:
            body = json.loads(self.rfile.read(n) or b'{}')
        except Exception as e:
            return self._send(400, json.dumps({'error': str(e)}))

        if p == '/api/world':
            with _lock:
                _world.sectors.clear()
                for sd in body.get('sectors', []):
                    # anything the editor saved has been looked at
                    sd.setdefault('source', 'confirmed')
                    s = Sector.from_dict(sd)
                    _world.sectors[s.sector_id] = s
                if 'homography' in body:
                    _world.homography = body['homography']
                _world._touch()
                _world.save()
                return self._send(200, json.dumps(
                    {'ok': True, 'revision': _world.revision,
                     'sectors': len(_world.sectors)}))

        if p == '/api/observe':
            try:
                x = float(body['x']); y = float(body['y'])
            except Exception:
                return self._send(400, json.dumps({'error': 'x and y required'}))
            with _lock:
                ch = _world.observe(x, y, kind=body.get('kind', 'unknown'),
                                    confidence=float(body.get('confidence', 0)))
                if ch:
                    _world.save()
                return self._send(200, json.dumps(
                    {'changed': ch, 'revision': _world.revision}))

        return self._send(404, json.dumps({'error': 'not found'}))


if __name__ == '__main__':
    os.makedirs(os.path.dirname(MAP_PATH), exist_ok=True)
    print(f'lightcv-api on :{PORT}  map={MAP_PATH} '
          f'sectors={len(_world.sectors)} things={len(_world.things)}',
          flush=True)
    ThreadingHTTPServer(('0.0.0.0', PORT), H).serve_forever()
