#!/usr/bin/env python3
"""End-to-end check of the world model, floor projection and renderer."""
import os, sys, time
import numpy as np
_R = os.path.dirname(os.path.dirname(os.path.abspath(__file__)))
sys.path.insert(0, _R)
from lightcv.world import World, Sector
from lightcv.floor import FloorPlane
from lightcv.render import MapRenderer, RenderCache
from lightcv.observe import Observer

fail = 0
def check(name, cond, extra=''):
    global fail
    print(f"  {'PASS' if cond else 'FAIL'}  {name}{(' -- '+extra) if extra else ''}")
    if not cond: fail += 1

print("== floor homography ==")
# a 300x250cm floor seen by a camera: near edge wide, far edge narrow
img_quad = [(240,700),(1040,700),(820,400),(460,400)]
map_quad = [(0,0),(300,0),(300,250),(0,250)]
# camera stands 60cm in front of the floor quad's near edge, centred
fp = FloorPlane.from_correspondences(img_quad, map_quad, camera_height_cm=75,
                                    camera_map_xy=(150.0, -60.0))
print("  quality:", fp.quality)
check("exact 4-pt solve flagged", fp.quality['exact_solve'] is True)
check("convex quad accepted", fp.quality['convex'] is True)
rt = fp.image_to_map(img_quad)
check("corners round-trip", np.allclose(rt, map_quad, atol=1e-3),
      f"max err {np.abs(rt-np.array(map_quad,float)).max():.2e}")
check("above-horizon rejected", fp.contact_to_map((600,100,40,40)) is None
      or not fp.is_below_horizon(620,140))

print("== sectors and heights ==")
w = World()
w.add_sector(Sector(map_quad, 0.0, 'floor', source='confirmed'))
w.add_sector(Sector([(60,90),(230,90),(230,190),(60,190)], 40.0, 'couch',
                    source='confirmed'))
check("floor sector found", w.floor_sector().label == 'floor')
check("point on open floor -> floor", w.sector_at(20, 20).label == 'floor')
check("point inside couch -> couch (higher wins)",
      w.sector_at(150,140).label == 'couch')
check("couch height 40", w.sector_at(150,140).floor_height == 40.0)

print("== the height correction ==")
# same image contact point, interpreted as floor vs as couch-top
p_floor = fp.contact_to_map((600,690,60,30), 0.0)
p_couch = fp.contact_to_map((600,690,60,30), 40.0)
import math
kx, ky = fp.camera_map_xy
d_floor = math.hypot(p_floor[0]-kx, p_floor[1]-ky)
d_couch = math.hypot(p_couch[0]-kx, p_couch[1]-ky)
check("raised contact pulls nearer to the CAMERA", d_couch < d_floor,
      f"floor d={d_floor:.1f}cm couch d={d_couch:.1f}cm ratio={d_couch/d_floor:.3f}")
check("ratio matches (C-h)/C", abs(d_couch/d_floor - (75-40)/75) < 1e-6)
check("no correction without a camera position",
      FloorPlane.from_correspondences(img_quad, map_quad, camera_height_cm=75)
        .can_correct_height() is False)
check("impossible height is a no-op", fp._raise_to_height(10,10,999) == (10,10))

print("== map is state, not a view ==")
obs = Observer(w, fp, min_evidence=0.30, semantic_floor=0.25)
class T:
    def __init__(s,cls,box,ev,conf): s.cls=cls; s.box=box; s.evidence=ev; s.confidence=conf; s.state='present'
r0 = w.revision
ch = obs.observe_track(T('cat',(600,660,70,40),0.9,0.43))
check("a strong track writes", ch and w.revision > r0)
th = list(w.things.values())[0]
check("thing landed on a sector", th.sector_id is not None,
      f"on {w.sectors[th.sector_id].label}")
r1 = w.revision
for _ in range(20):
    obs.observe_track(T('cat',(600,660,70,40),0.9,0.43))
check("re-observing a still thing does NOT churn revision", w.revision == r1)
t0 = time.time()
check("nothing decays with time", w.revision == r1 and len(w.things) == 1)
check("weak track is refused", not obs.observe_track(T('cat',(600,660,70,40),0.05,0.43)))
check("sub-floor confidence writes kind=unknown",
      (obs.observe_track(T('cat',(300,660,70,40),0.9,0.10)) and
       any(t.kind=='unknown' for t in w.things.values())))

print("== render on change, not per frame ==")
rc = RenderCache(MapRenderer(700,500))
img = rc.frame_for(w)
for _ in range(200): rc.frame_for(w)
check("200 reads -> 1 render", rc.renders == 1, f"renders={rc.renders} hits={rc.hits}")
w.observe(120, 60, kind='cat', confidence=0.5)
rc.frame_for(w)
check("a write forces a re-render", rc.renders == 2)
ts=[]
for _ in range(30):
    a=time.perf_counter(); rc.frame_for(w, force=True); ts.append((time.perf_counter()-a)*1000)
print(f"  render cost: mean {np.mean(ts):.2f}ms  max {np.max(ts):.2f}ms")

print("== persistence ==")
import tempfile
p = os.path.join(tempfile.mkdtemp(), 'world.json')
w.path = p; w.save()
w2 = World.load(p)
check("round-trips", len(w2.sectors)==len(w.sectors) and len(w2.things)==len(w.things))
check("heights survive", w2.sector_at(150,140).floor_height == 40.0)

print(f"\n{'ALL PASS' if not fail else str(fail)+' FAILURES'}")
sys.exit(1 if fail else 0)
