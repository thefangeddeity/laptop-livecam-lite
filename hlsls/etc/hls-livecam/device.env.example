# hls-livecam-server — persistent device configuration
# Written by hls-livecam-setup; consumed by hls-livecam-repair.
#
# NOTE: ffmpeg-cam.service reads its camera configuration from the literal
# ExecStart line in the systemd unit, not from this file. This file provides
# device-specific settings for repair and CV Mode.

VIDEO_DEVICE=/dev/v4l/by-id/usb-Sonix_Technology_Co.__Ltd._USB_2.0_Camera_SN0001-video-index0
V4L2_INPUT_FMT=-input_format mjpeg
# 720p stopped delivering data after the USB fault of 2026-08-27 (error -71,
# then STREAMON succeeding but the stream carrying nothing). 640x480 works on
# the same link. Restore to 1280x720 after a PHYSICAL replug of the camera.
VIDEO_SIZE=640x480
FRAMERATE=8

# Image correction
CV_HIGHLIGHT_CEILING=232
CV_HIGHLIGHT_THRESHOLD=190
CV_HIGHLIGHT_GAMMA=0.85
CV_CLAHE_CLIP=1.0
CV_SHADOW_LIFT=0.7
CV_SHADOW_RANGE=125
CV_UNSHARP_AMOUNT=0.6

# Edge enhancement
CV_EDGE_STYLE=overlay
CV_EDGE_STRENGTH=0.30
CV_EDGE_SHARPNESS_OFF=120

# Object detection
CV_DETECT_ENABLED=1
CV_DETECT_BACKEND=onnx
CV_DETECT_INTERVAL=8
CV_DETECT_MODEL=/usr/share/hls-livecam-server/models/candidates/yolov8n.onnx
CV_DETECT_CLASSES=cat
CV_DETECT_CONF=0.05
CV_HUD_ENABLED=1

# Lens-artifact learning/subtraction
CV_ARTIFACT_ENABLED=1

# Retired Sharpie settings — retained as comments for reference.
# CV_EDGE_STYLE=sharpie
# CV_SHARPIE_LEVELS=18
# CV_SHARPIE_THICK=1
# CV_SHARPIE_SCALE=0.75
# CV_SHARPIE_BLEND=1.0
CV_GRID_CORRECT_ENABLED=1
CV_GRID_CORRECT_STRENGTH=0.6

# Room audio (run-21). Capture arrived muted and at 0 on this node; set to
# 58 with alsactl store. Range is steep here -- 45 is already near-silent.
AUDIO_ENABLED=1
AUDIO_BACKEND=alsa
AUDIO_DEVICE=hw:0,0
AUDIO_BITRATE=96k
AUDIO_SAMPLE_RATE=48000
AUDIO_CHANNELS=2
# Capture staging, forced at every publisher start -- this card has no
# 'Internal Mic Boost'; the control here is plain 'Mic Boost'.
AUDIO_MIXER_CARD=0
AUDIO_MIXER_LEVELS=Capture=80,Mic Boost=2
AUDIO_GAIN_DB=12

# Temporal denoise weights, moved out of the source in 6.0.0. tina ran
# 0.60/0.20/0.20 as a local edit to cv_processor.py, which meant every
# package upgrade silently reverted it back to the fleet default. Node
# tuning lives here now, where no installer touches it.
CV_TEMPORAL_W_CUR=0.60
CV_TEMPORAL_W_PREV=0.20
